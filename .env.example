# ---------------------------------------------------------------------------
# Local development environment.
# Copy this file to `.env` and fill in the values you need.
#
# On Render these are set in the dashboard or via render.yaml — do not put
# real production secrets in this file (it is committed to git).
# ---------------------------------------------------------------------------

# Port the Express server listens on. Render sets this automatically.
PORT=3000

# Secret used to sign JWT auth tokens. REQUIRED — the server refuses to boot
# without it. Use a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=replace_with_a_long_random_string

# Database connection string. When set, the app uses Postgres.
# When unset (local dev default), the app falls back to a file-based SQLite
# database at ./database.sqlite — no Postgres install required.
# Example (Render): postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# Admin login for /admin (the business admin dashboard).
# If unset, admin login simply fails with invalid credentials.
ADMIN_USER=admin
ADMIN_PASS=change_me

# Brevo (Sendinblue) — used to send appointment-confirmation emails.
# The app boots fine without these; only the email-send path fails.
BREVO_API_KEY=
SENDER_EMAIL=

# Cashfree payment gateway credentials (from your merchant dashboard).
# In dev the app talks to the SANDBOX environment; in prod (NODE_ENV=production)
# it talks to PRODUCTION automatically.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Comma-separated list of allowed CORS origins for the API.
# Leave empty to reflect the request origin (fine for a same-host SPA).
# Example: https://app.example.com,https://staging.example.com
ALLOWED_ORIGINS=
