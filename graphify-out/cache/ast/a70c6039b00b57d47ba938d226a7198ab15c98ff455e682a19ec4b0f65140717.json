style={{ position: 'sticky', left: 0, background: 'var(--bg-secondary)' }}>Staff</th>\n                        {days.map(d => (\n                          <th key={d} style={{ textAlign: 'center' }}>\n                            <div>{new Date(d).toLocaleDateString('en-US', { weekday: 'short' })}</div>\n                            <div style={{ fontSize: '12px', color: 'var(--text-muted)', fontWeight: 400 }}>{new Date(d).getDate()}</div>\n                          </th>\n                        ))}\n                      </tr>\n                    </thead>\n                    <tbody>\n                      {staffRows.map(st => (\n                        <tr key={st.id}>\n                          <td style={{ position: 'sticky', left: 0, background: 'var(--bg-secondary)', fontWeight: 600 }}>{st.name}</td>\n                          {days.map(d => {\n                            const dayAppts = calendarAppointments.filter(a => a.staffId === st.id && a.date === d);\n                            return (\n                              <td key={d} style={{ verticalAlign: 'top', padding: '6px', minWidth: '120px' }}>\n                                {dayAppts.length === 0 ? (\n                                  <span style={{ color: 'var(--text-muted)', fontSize: '12px' }}>\u2014</span>\n                                ) : (\n                                  <div style={{ display: 'flex', flexDirection: 'column', gap: '4px' }}>\n                                    {dayAppts.map(a => (\n                                      <div key={a.id} style={{\n                                        background: a.status === 'cancelled' || a.status === 'declined' ? 'var(--bg-tertiary)' : 'var(--primary)',\n                                        color: a.status === 'cancelled' || a.status === 'declined' ? 'var(--text-muted)' : 'white',\n                                        padding: '4px 6px', borderRadius: '4px', fontSize: '11px',\n                                        textDecoration: a.status === 'cancelled' || a.status === 'declined' ? 'line-through' : 'none',\n                                      }} title={`${a.user?.name || ''} \u2014 ${a.service?.name || ''} (${a.status})`}>\n                                        <div style={{ fontWeight: 600 }}>{a.time}</div>\n                                        <div style={{ opacity: 0.9 }}>{a.user?.name || 'Customer'}</div>\n                                      </div>\n                                    ))}\n                                  </div>\n                                )}\n                              </td>\n                            );\n                          })}\n                        </tr>\n                      ))}\n                    </tbody>\n                  </table>\n                </div>\n              );\n            })", "is_member_call": false, "source_file": "C:\\Users\\sanpa\\OneDrive\\Desktop\\Fun projects\\Salon App\\fresha-salon-app\\frontend\\src\\pages\\salon\\SalonDashboard.jsx", "source_location": "L678"}, {"caller_nid": "salon_salondashboard_salondashboard", "callee": "map", "is_member_call": true, "source_file": "C:\\Users\\sanpa\\OneDrive\\Desktop\\Fun projects\\Salon App\\fresha-salon-app\\frontend\\src\\pages\\salon\\SalonDashboard.jsx", "source_location": "L775"}, {"caller_nid": "salon_salondashboard_salondashboard", "callee": "map", "is_member_call": true, "source_file": "C:\\Users\\sanpa\\OneDrive\\Desktop\\Fun projects\\Salon App\\fresha-salon-app\\frontend\\src\\pages\\salon\\SalonDashboard.jsx", "source_location": "L863"}, {"caller_nid": "salon_salondashboard_salondashboard", "callee": "toFixed", "is_member_call": true, "source_file": "C:\\Users\\sanpa\\OneDrive\\Desktop\\Fun projects\\Salon App\\fresha-salon-app\\frontend\\src\\pages\\salon\\SalonDashboard.jsx", "source_location": "L947"}, {"caller_nid": "salon_salondashboard_salondashboard", "callee": "Number", "is_member_call": false, "source_file": "C:\\Users\\sanpa\\OneDrive\\Deskt